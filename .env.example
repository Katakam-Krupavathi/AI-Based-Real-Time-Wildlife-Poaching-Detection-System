# AI-Based Real-Time Wildlife Poaching Detection System - Environment Configuration Template

# Server Port
PORT=5000

# Proximity Thresholds
# BBOX_PROXIMITY_PX: Pixel distance threshold between human and gun/jacket bounding box centers
BBOX_PROXIMITY_PX=150
# LORA_RSSI_THRESHOLD: Signal strength threshold (dBm) for verified LoRa ranger device proximity
LORA_RSSI_THRESHOLD=-70

# Security Keys
DAILY_PASSCODE=9382
LORA_SECRET_KEY=RANGER_SECRET_2025

# Twilio SMS Alert Credentials (leave empty for mock simulation mode)
TWILIO_SID=your_twilio_account_sid_here
TWILIO_TOKEN=your_twilio_auth_token_here
TWILIO_FROM=+1234567890
TWILIO_TO=+1987654321

# Model & Normalization Paths (defaults to repository root)
# YOLO_MODEL_PATH=best.pt
# GUNSHOT_MODEL_PATH=gunshot_model_v3.h5
# MEAN_PATH=train_mean.npy
# STD_PATH=train_std.npy
